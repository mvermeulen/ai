// Helper functions for uint128
bool equal(uint128 a, uint128 b) {
    return a.low == b.low && a.high == b.high;
}

bool less_than(uint128 a, uint128 b) {
    if (a.high != b.high) return a.high < b.high;
    return a.low < b.low;
}

bool greater_than(uint128 a, uint128 b) {
    if (a.high != b.high) return a.high > b.high;
    return a.low > b.low;
}

uint128 add(uint128 a, uint128 b) {
    uint128 res;
    res.low = a.low + b.low;
    uint64_t carry = (res.low < a.low) ? 1UL : 0UL;
    res.high = a.high + b.high + carry;
    return res;
}

uint128 sub(uint128 a, uint128 b) {
    uint128 res;
    res.low = a.low - b.low;
    uint64_t borrow = (a.low < b.low) ? 1UL : 0UL;
    res.high = a.high - b.high - borrow;
    return res;
}

bool less_than_or_equal(uint128 a, uint128 b) {
    return !greater_than(a, b);
}

bool greater_than_or_equal(uint128 a, uint128 b) {
    return !less_than(a, b);
}


uint128 shift_left_1(uint128 a, out bool overflow) {
    uint128 res;
    overflow = (a.high & 0x8000000000000000UL) != 0UL;
    res.high = (a.high << 1UL) | (a.low >> 63UL);
    res.low = a.low << 1UL;
    return res;
}

uint128 shift_right(uint128 a, uint p) {
    uint128 res;
    res.low = 0UL;
    res.high = 0UL;
    if (p <= 0) {
        return a;
    } else if (p < 64) {
        res.low = (a.low >> p) | (a.high << (64 - p));
        res.high = a.high >> p;
    } else if (p < 128) {
        res.low = a.high >> (p - 64);
        res.high = 0UL;
    }
    return res;
}

uint128 shift_left(uint128 a, uint p) {
    uint128 res;
    res.low = 0UL;
    res.high = 0UL;
    if (p <= 0) {
        return a;
    } else if (p < 64) {
        res.high = (a.high << p) | (a.low >> (64 - p));
        res.low = a.low << p;
    } else if (p < 128) {
        res.high = a.low << (p - 64);
        res.low = 0UL;
    }
    return res;
}

uint ctz64(uint64_t val) {
    uint low32 = uint(val & 0xFFFFFFFFUL);
    int lsb = findLSB(low32);
    if (lsb != -1) {
        return uint(lsb);
    }
    uint high32 = uint(val >> 32UL);
    lsb = findLSB(high32);
    if (lsb != -1) {
        return uint(lsb + 32);
    }
    return 64;
}

uint count_trailing_zeros(uint128 a) {
    if (a.low != 0UL) {
        return ctz64(a.low);
    } else if (a.high != 0UL) {
        return 64 + ctz64(a.high);
    } else {
        return 128;
    }
}

uint clz64(uint64_t val) {
    uint high32 = uint(val >> 32UL);
    int msb = findMSB(high32);
    if (msb != -1) {
        return uint(31 - msb);
    }
    uint low32 = uint(val & 0xFFFFFFFFUL);
    msb = findMSB(low32);
    if (msb != -1) {
        return uint(63 - msb);
    }
    return 64;
}

uint count_leading_zeros(uint128 a) {
    if (a.high != 0UL) {
        return clz64(a.high);
    } else if (a.low != 0UL) {
        return 64 + clz64(a.low);
    } else {
        return 128;
    }
}


bool check_mul3_add1_overflow(uint128 n) {
    if (n.high > 0x5555555555555555UL) return true;
    if (n.high == 0x5555555555555555UL && n.low > 0x5555555555555554UL) return true;
    return false;
}

uint128 mul3_add1(uint128 n, out bool overflow) {
    if (check_mul3_add1_overflow(n)) {
        overflow = true;
        uint128 zero;
        zero.low = 0UL;
        zero.high = 0UL;
        return zero;
    }
    overflow = false;
    bool temp_of;
    uint128 n2 = shift_left_1(n, temp_of);
    uint128 n3 = add(n2, n);
    uint128 one;
    one.low = 1UL;
    one.high = 0UL;
    return add(n3, one);
}

uint128 mul64x64(uint64_t x, uint64_t y) {
    uint64_t x_low = x & 0xFFFFFFFFUL;
    uint64_t x_high = x >> 32UL;
    uint64_t y_low = y & 0xFFFFFFFFUL;
    uint64_t y_high = y >> 32UL;

    uint64_t p00 = x_low * y_low;
    uint64_t p01 = x_low * y_high;
    uint64_t p10 = x_high * y_low;
    uint64_t p11 = x_high * y_high;

    uint64_t carry = 0UL;
    uint64_t mid = p01 + p10;
    if (mid < p01) {
        carry = 1UL << 32UL;
    }

    uint64_t low_part = p00 + (mid << 32UL);
    if (low_part < p00) {
        p11 += 1UL;
    }
    uint64_t high_part = p11 + (mid >> 32UL) + carry;

    uint128 res;
    res.low = low_part;
    res.high = high_part;
    return res;
}

uint128 mul_uint64_check_overflow(uint128 a, uint64_t b, out bool overflow) {
    if (b == 0UL) {
        overflow = false;
        uint128 zero;
        zero.low = 0UL;
        zero.high = 0UL;
        return zero;
    }

    uint128 low_prod = mul64x64(a.low, b);
    
    uint128 high_prod = mul64x64(a.high, b);
    if (high_prod.high != 0UL) {
        overflow = true;
        uint128 zero;
        zero.low = 0UL;
        zero.high = 0UL;
        return zero;
    }
    
    uint64_t final_high = high_prod.low + low_prod.high;
    if (final_high < high_prod.low) {
        overflow = true;
        uint128 zero;
        zero.low = 0UL;
        zero.high = 0UL;
        return zero;
    }
    
    overflow = false;
    uint128 res;
    res.low = low_prod.low;
    res.high = final_high;
    return res;
}

uint128 add_check_overflow(uint128 a, uint128 b, out bool overflow) {
    uint128 res;
    res.low = a.low + b.low;
    uint64_t carry = (res.low < a.low) ? 1UL : 0UL;
    res.high = a.high + b.high + carry;
    bool carry_high = (res.high < a.high) || (carry == 1UL && res.high == a.high);
    overflow = carry_high;
    return res;
}
shared uint64_t shared_max_val_low[256];
shared uint64_t shared_max_val_high[256];
shared uint shared_steps[256];
shared uint shared_sigma[256];
shared bool workgroup_has_candidate;


void main() {
    // Read initial global peaks at start of invocation from push constants to avoid dynamic thread blocking and race conditions
    uint128 init_max_val;
    init_max_val.low = pcs.init_max_val_low;
    init_max_val.high = pcs.init_max_val_high;
    uint init_max_steps = pcs.init_max_steps;
    uint init_max_sigma = pcs.init_max_sigma;

    uint g_id = gl_GlobalInvocationID.x;
    uint l_id = gl_LocalInvocationID.x;

    bool active_thread;
    uint128 n;
    uint64_t n_64 = 0UL;

    if (USE_SUFFIX_FIRST) {
        active_thread = (g_id < pcs.total_work_items);
        if (active_thread) {
            uint prefix_index = g_id / pcs.allowed_suffixes_size;
            uint suffix_index = g_id % pcs.allowed_suffixes_size;
            uint suffix = allowed_suffixes.allowed[pcs.allowed_offset + suffix_index];

            if (USE_64BIT) {
                uint64_t prefix = pcs.start_prefix_low + uint64_t(prefix_index) * uint64_t(pcs.prefix_stride);
                uint64_t curr = (prefix << pcs.cutoff_width) | uint64_t(suffix);
                n_64 = curr;

                if (pcs.check_start != 0 && curr < pcs.start_val_low) {
                    active_thread = false;
                } else if (pcs.check_end != 0 && curr > pcs.end_val_low) {
                    active_thread = false;
                }
            } else {
                uint128 start_prefix;
                start_prefix.low = pcs.start_prefix_low;
                start_prefix.high = pcs.start_prefix_high;
                uint128 prefix = add(start_prefix, uint128(uint64_t(prefix_index) * uint64_t(pcs.prefix_stride), 0UL));
                uint128 curr = add(shift_left(prefix, pcs.cutoff_width), uint128(uint64_t(suffix), 0UL));
                n = curr;

                uint128 start_val;
                start_val.low = pcs.start_val_low;
                start_val.high = pcs.start_val_high;
                uint128 end_val;
                end_val.low = pcs.end_val_low;
                end_val.high = pcs.end_val_high;

                if (pcs.check_start != 0 && less_than(curr, start_val)) {
                    active_thread = false;
                } else if (pcs.check_end != 0 && greater_than(curr, end_val)) {
                    active_thread = false;
                }
            }
        }
    } else {
        active_thread = (g_id < pcs.total_work_items);
        if (USE_64BIT) {
            n_64 = pcs.start_val_low + uint64_t(g_id) * 2UL;
            if (active_thread) {
                if (n_64 % 3UL == 2UL) {
                    atomicAdd(global_metrics.skipped_mod6, 1UL);
                    atomicAdd(global_metrics.total_checked, 1UL);
                    active_thread = false;
                }
            }
        } else {
            uint128 start_pct;
            start_pct.low = pcs.start_val_low;
            start_pct.high = pcs.start_val_high;
            uint128 step_val;
            step_val.low = uint64_t(g_id) * 2UL;
            step_val.high = 0UL;
            n = add(start_pct, step_val);
            if (active_thread) {
                uint64_t sum_mod3 = (n.high % 3UL + n.low % 3UL) % 3UL;
                if (sum_mod3 == 2UL) {
                    atomicAdd(global_metrics.skipped_mod6, 1UL);
                    atomicAdd(global_metrics.total_checked, 1UL);
                    active_thread = false;
                }
            }
        }
    }

    // Base cases
    uint128 one;
    one.low = 1UL;
    one.high = 0UL;

    uint128 two;
    two.low = 2UL;
    two.high = 0UL;

    uint steps = 0;
    uint stopping_time = 0;
    uint128 max_val;
    max_val.low = 0UL;
    max_val.high = 0UL;
    uint64_t max_val_64 = 0UL;
    bool overflowed = false;

    if (active_thread) {
        if (USE_64BIT) {
            max_val_64 = n_64;
            if (n_64 == 1UL) {
                steps = 0;
                stopping_time = 0;
                max_val_64 = 1UL;
            } else if (n_64 == 2UL) {
                steps = 1;
                stopping_time = 1;
                max_val_64 = 2UL;
            } else {
                uint64_t curr = n_64;
                uint t_steps = 0;
                bool has_stopped_sigma = false;
                bool dropped_below_start = false;

                if (USE_DOMAIN_SWITCHING) {
                    if (n_64 < 256UL) {
                        while (curr > 1UL) {
                            if (curr > 0x5555555555555555UL) {
                                overflowed = true;
                                break;
                            }
                            uint64_t next_val = 3UL * curr + 1UL;
                            steps++;
                            if (!dropped_below_start) {
                                if (next_val > max_val_64) {
                                    max_val_64 = next_val;
                                }
                            }
                            uint p = ctz64(next_val);
                            if (!has_stopped_sigma) {
                                for (uint k = 1; k <= p; ++k) {
                                    uint64_t val_k = next_val >> k;
                                    if (val_k < n_64) {
                                        stopping_time = t_steps + k;
                                        has_stopped_sigma = true;
                                        break;
                                    }
                                }
                            }
                            curr = next_val >> p;
                            steps += p;
                            t_steps += p;
                            if (curr < n_64) {
                                dropped_below_start = true;
                            }
                        }
                    } else {
                        while (curr >= 256UL) {
                            curr = curr + 1UL;
                            uint alpha = ctz64(curr | (1UL << 40));
                            uint64_t k = curr >> alpha;
                            if (k > max_safe_k_64[alpha]) {
                                overflowed = true;
                                break;
                            }
                            uint64_t m = k * lut3_64[alpha];
                            if ((m & 0x8000000000000000UL) != 0UL) {
                                overflowed = true;
                                break;
                            }
                            uint64_t n_new = m - 1UL;
                            uint beta = ctz64(n_new);
                            if (!dropped_below_start) {
                                uint64_t segment_peak = (m << 1UL) - 2UL;
                                if (segment_peak > max_val_64) {
                                    max_val_64 = segment_peak;
                                }
                            }
                            if (!has_stopped_sigma) {
                                uint L_m = 64 - clz64(n_new);
                                uint L_n = 64 - clz64(n_64);
                                int j = int(L_m) - int(L_n);
                                if (j < 1) j = 1;
                                if (n_64 <= (n_new >> uint(j))) {
                                    j++;
                                }
                                if (uint(j) <= beta) {
                                    stopping_time = t_steps + alpha + uint(j);
                                    has_stopped_sigma = true;
                                }
                            }
                            steps += 2 * alpha + beta;
                            t_steps += alpha + beta;
                            curr = n_new >> beta;
                            if (curr < n_64) {
                                dropped_below_start = true;
                            }
                        }
                        if (!overflowed && curr > 1UL && curr < 256UL) {
                            steps += steps_table.steps[uint(curr)];
                        }
                    }
                } else {
                    if (n_64 < 256UL) {
                        while (curr > 1UL) {
                            if (curr > 0x5555555555555555UL) {
                                overflowed = true;
                                break;
                            }
                            uint64_t next_val = 3UL * curr + 1UL;
                            steps++;
                            if (!dropped_below_start) {
                                if (next_val > max_val_64) {
                                    max_val_64 = next_val;
                                }
                            }
                            uint p = ctz64(next_val);
                            if (!has_stopped_sigma) {
                                for (uint k = 1; k <= p; ++k) {
                                    uint64_t val_k = next_val >> k;
                                    if (val_k < n_64) {
                                        stopping_time = t_steps + k;
                                        has_stopped_sigma = true;
                                        break;
                                    }
                                }
                            }
                            curr = next_val >> p;
                            steps += p;
                            t_steps += p;
                            if (curr < n_64) {
                                dropped_below_start = true;
                            }
                        }
                    } else {
                        while (curr >= 256UL) {
                            if (curr > 0x5555555555555555UL) {
                                overflowed = true;
                                break;
                            }
                            uint64_t next_val = 3UL * curr + 1UL;
                            steps++;
                            if (!dropped_below_start) {
                                if (next_val > max_val_64) {
                                    max_val_64 = next_val;
                                }
                            }
                            uint p = ctz64(next_val);
                            if (!has_stopped_sigma) {
                                for (uint k = 1; k <= p; ++k) {
                                    uint64_t val_k = next_val >> k;
                                    if (val_k < n_64) {
                                        stopping_time = t_steps + k;
                                        has_stopped_sigma = true;
                                        break;
                                    }
                                }
                            }
                            curr = next_val >> p;
                            steps += p;
                            t_steps += p;
                            if (curr < n_64) {
                                dropped_below_start = true;
                            }
                        }
                        if (!overflowed && curr > 1UL && curr < 256UL) {
                            steps += steps_table.steps[uint(curr)];
                        }
                    }
                }
            }
        } else {
            max_val = n;
            if (equal(n, one)) {
                steps = 0;
                stopping_time = 0;
                max_val = one;
            } else if (equal(n, two)) {
                steps = 1;
                stopping_time = 1;
                max_val = two;
            } else {
                uint128 curr = n;
                uint t_steps = 0;
                bool has_stopped_sigma = false;
                bool dropped_below_start = false;

                uint128 limit;
                limit.low = 256UL;
                limit.high = 0UL;
                if (USE_DOMAIN_SWITCHING) {
                    if (less_than(n, limit)) {
                        while (greater_than(curr, one)) {
                            bool overflow = false;
                            uint128 next_val = mul3_add1(curr, overflow);
                            if (overflow) {
                                overflowed = true;
                                break;
                            }
                            steps++;
                            if (!dropped_below_start) {
                                if (greater_than(next_val, max_val)) {
                                    max_val = next_val;
                                }
                            }
                            uint p = count_trailing_zeros(next_val);
                            if (!has_stopped_sigma) {
                                for (uint k = 1; k <= p; ++k) {
                                    uint128 val_k = shift_right(next_val, k);
                                    if (less_than(val_k, n)) {
                                        stopping_time = t_steps + k;
                                        has_stopped_sigma = true;
                                        break;
                                    }
                                }
                            }
                            next_val = shift_right(next_val, p);
                            steps += p;
                            t_steps += p;
                            curr = next_val;
                            if (less_than(curr, n)) {
                                dropped_below_start = true;
                            }
                        }
                    } else {
                        while (greater_than_or_equal(curr, limit)) {
                            if (curr.high == 0UL && curr.low < 0x100000000UL && dropped_below_start && has_stopped_sigma) {
                                if (steps + 1050 < init_max_steps) {
                                    curr = one;
                                    break;
                                }
                                uint64_t curr_64 = curr.low;
                                while (curr_64 >= 256UL) {
                                    uint64_t next_val = 3UL * curr_64 + 1UL;
                                    steps++;
                                    uint extra_div = ctz64(next_val);
                                    curr_64 = next_val >> extra_div;
                                    steps += extra_div;
                                }
                                curr.low = curr_64;
                                curr.high = 0UL;
                                break;
                            }

                            // Enter n+1 domain
                            curr = add(curr, one);
                            uint alpha = ctz64(curr.low | (1UL << 40));
                            uint128 k = shift_right(curr, alpha);
                            if (greater_than(k, max_safe_k_128[alpha])) {
                                overflowed = true;
                                break;
                            }
                            
                            bool mul_of = false;
                            uint128 m = mul_uint64_check_overflow(k, lut3_128[alpha].low, mul_of);
                            if (mul_of) {
                                overflowed = true;
                                break;
                            }
                            
                            if ((m.high & 0x8000000000000000UL) != 0UL) {
                                overflowed = true;
                                break;
                            }

                            uint128 n_new = sub(m, one);
                            uint beta = count_trailing_zeros(n_new);

                            if (!dropped_below_start) {
                                bool of_peak = false;
                                uint128 segment_peak = sub(shift_left_1(m, of_peak), two);
                                if (greater_than(segment_peak, max_val)) {
                                    max_val = segment_peak;
                                }
                            }

                            if (!has_stopped_sigma) {
                                int L_m = 128 - int(count_leading_zeros(n_new));
                                int L_n = 128 - int(count_leading_zeros(n));
                                int j = L_m - L_n;
                                if (j < 1) j = 1;

                                if (less_than_or_equal(n, shift_right(n_new, uint(j)))) {
                                    j++;
                                }
                                if (uint(j) <= beta) {
                                    stopping_time = t_steps + alpha + uint(j);
                                    has_stopped_sigma = true;
                                }
                            }

                            steps += 2 * alpha + beta;
                            t_steps += alpha + beta;
                            curr = shift_right(n_new, beta);

                            if (less_than(curr, n)) {
                                dropped_below_start = true;
                            }
                        }
                        if (!overflowed && greater_than(curr, one) && curr.high == 0UL && curr.low < 256UL) {
                            steps += steps_table.steps[uint(curr.low)];
                        }
                    }
                } else {
                    if (less_than(n, limit)) {
                        while (greater_than(curr, one)) {
                            bool overflow = false;
                            uint128 next_val = mul3_add1(curr, overflow);
                            if (overflow) {
                                overflowed = true;
                                break;
                            }
                            steps++;
                            if (!dropped_below_start) {
                                if (greater_than(next_val, max_val)) {
                                    max_val = next_val;
                                }
                            }
                            uint p = count_trailing_zeros(next_val);
                            if (!has_stopped_sigma) {
                                for (uint k = 1; k <= p; ++k) {
                                    uint128 val_k = shift_right(next_val, k);
                                    if (less_than(val_k, n)) {
                                        stopping_time = t_steps + k;
                                        has_stopped_sigma = true;
                                        break;
                                    }
                                }
                            }
                            next_val = shift_right(next_val, p);
                            steps += p;
                            t_steps += p;
                            curr = next_val;
                            if (less_than(curr, n)) {
                                dropped_below_start = true;
                            }
                        }
                    } else {
                        // Initial polynomial check and possible immediate jump
                        bool init_odd = ((n.low & 1UL) != 0UL);
                        if (init_odd && !dropped_below_start) {
                            uint initial_suffix = uint(n.low & 255UL);
                            poly init_p = fpoly_table.polys[initial_suffix];
                            if (init_p.smaller != 0) {
                                dropped_below_start = true;
                                has_stopped_sigma = true;
 
                                bool overflow = false;
                                uint128 next_val = mul_uint64_check_overflow(shift_right(curr, 8), uint64_t(init_p.mul3), overflow);
                                if (overflow) {
                                    overflowed = true;
                                } else {
                                    next_val = add_check_overflow(next_val, uint128(uint64_t(init_p.add), 0UL), overflow);
                                    if (overflow) {
                                        overflowed = true;
                                    } else {
                                        uint extra_div = count_trailing_zeros(next_val);
                                        curr = shift_right(next_val, extra_div);
                                        steps += init_p.steps + extra_div;
                                    }
                                }
                            }
                        }
 
                        if (!overflowed) {
                            // Phase 1 Loop: standard Collatz iterations before dropped_below_start is true
                            while (greater_than(curr, limit) && !dropped_below_start) {
                                bool overflow = false;
                                uint128 next_val = mul3_add1(curr, overflow);
                                if (overflow) {
                                    overflowed = true;
                                    break;
                                }
                                steps++;
 
                                if (greater_than(next_val, max_val)) {
                                    max_val = next_val;
                                }
 
                                uint p = count_trailing_zeros(next_val);
                                if (!has_stopped_sigma) {
                                    for (uint k = 1; k <= p; ++k) {
                                        uint128 val_k = shift_right(next_val, k);
                                        if (less_than(val_k, n)) {
                                            stopping_time = t_steps + k;
                                            has_stopped_sigma = true;
                                            break;
                                        }
                                    }
                                }
                                next_val = shift_right(next_val, p);
                                steps += p;
                                t_steps += p;
                                curr = next_val;
                                if (less_than(curr, n)) {
                                    dropped_below_start = true;
                                }
                            }
 
                            // Phase 2 Loop: fast polynomial jumps after dropped_below_start is true
                            while (greater_than(curr, limit) && !overflowed) {
                                if (curr.high == 0UL && curr.low < 0x100000000UL) {
                                    if (steps + 1050 < init_max_steps) {
                                        curr = one;
                                        break;
                                    }
                                    uint64_t curr_64 = curr.low;
                                    while (curr_64 >= 256UL) {
                                        uint r = uint(curr_64 & 255UL);
                                        poly p = fpoly_table.polys[r];
                                        uint64_t next_val = (curr_64 >> 8) * uint64_t(p.mul3) + uint64_t(p.add);
                                        uint extra_div = ctz64(next_val);
                                        curr_64 = next_val >> extra_div;
                                        steps += p.steps + extra_div;
                                    }
                                    curr.low = curr_64;
                                    curr.high = 0UL;
                                    break;
                                }
 
                                uint r = uint(curr.low & 255UL);
                                poly p = fpoly_table.polys[r];
 
                                bool overflow = false;
                                uint128 next_val = mul_uint64_check_overflow(shift_right(curr, 8), uint64_t(p.mul3), overflow);
                                if (overflow) {
                                    overflowed = true;
                                    break;
                                }
                                next_val = add_check_overflow(next_val, uint128(uint64_t(p.add), 0UL), overflow);
                                if (overflow) {
                                    overflowed = true;
                                    break;
                                }
 
                                uint extra_div = count_trailing_zeros(next_val);
                                curr = shift_right(next_val, extra_div);
                                steps += p.steps + extra_div;
                            }
                        }
                        if (!overflowed && greater_than(curr, one) && curr.high == 0UL && curr.low < 256UL) {
                            steps += steps_table.steps[uint(curr.low)];
                        }
                    }
                }
            }
        }
    }

    if (active_thread) {
        if (!USE_SUFFIX_FIRST) {
            atomicAdd(global_metrics.total_checked, 1UL);
        }
        if (overflowed) {
            atomicAdd(global_metrics.overflowed, 1UL);
            active_thread = false;
        } else {
            atomicAdd(global_metrics.total_steps, uint64_t(steps));
        }
    }

    if (active_thread && USE_64BIT) {
        max_val.low = max_val_64;
        max_val.high = 0UL;
        n.low = n_64;
        n.high = 0UL;
    }

    // Check if any thread has a peak candidate
    bool has_candidate = false;
    if (active_thread) {
        if (USE_64BIT) {
            has_candidate = (max_val_64 > init_max_val.low) || (steps > init_max_steps) || (stopping_time > init_max_sigma);
        } else {
            has_candidate = greater_than(max_val, init_max_val) || (steps > init_max_steps) || (stopping_time > init_max_sigma);
        }
    }

    if (l_id == 0) {
        workgroup_has_candidate = false;
    }
    barrier();

    if (has_candidate) {
        workgroup_has_candidate = true;
    }
    barrier();

    if (!workgroup_has_candidate) {
        return;
    }

    // Workgroup reduction & prefix scan to log local peaks
    shared_max_val_low[l_id] = active_thread ? max_val.low : 0UL;
    shared_max_val_high[l_id] = active_thread ? max_val.high : 0UL;
    shared_steps[l_id] = active_thread ? steps : 0;
    shared_sigma[l_id] = active_thread ? stopping_time : 0;
    barrier();

    // 1. Unrolled Kogge-Stone prefix scan for stride 1, 2, 4, 8, 16, 32, 64, 128
    // Stride 1
    {
        uint64_t t_low = 0UL; uint64_t t_high = 0UL; uint t_st = 0; uint t_si = 0;
        if (l_id >= 1) {
            t_low = shared_max_val_low[l_id - 1];
            t_high = shared_max_val_high[l_id - 1];
            t_st = shared_steps[l_id - 1];
            t_si = shared_sigma[l_id - 1];
        }
        barrier();
        if (l_id >= 1) {
            uint128 temp; temp.low = t_low; temp.high = t_high;
            uint128 my_val; my_val.low = shared_max_val_low[l_id]; my_val.high = shared_max_val_high[l_id];
            if (greater_than(temp, my_val)) {
                shared_max_val_low[l_id] = temp.low;
                shared_max_val_high[l_id] = temp.high;
            }
            if (t_st > shared_steps[l_id]) {
                shared_steps[l_id] = t_st;
            }
            if (t_si > shared_sigma[l_id]) {
                shared_sigma[l_id] = t_si;
            }
        }
        barrier();
    }

    // Stride 2
    {
        uint64_t t_low = 0UL; uint64_t t_high = 0UL; uint t_st = 0; uint t_si = 0;
        if (l_id >= 2) {
            t_low = shared_max_val_low[l_id - 2];
            t_high = shared_max_val_high[l_id - 2];
            t_st = shared_steps[l_id - 2];
            t_si = shared_sigma[l_id - 2];
        }
        barrier();
        if (l_id >= 2) {
            uint128 temp; temp.low = t_low; temp.high = t_high;
            uint128 my_val; my_val.low = shared_max_val_low[l_id]; my_val.high = shared_max_val_high[l_id];
            if (greater_than(temp, my_val)) {
                shared_max_val_low[l_id] = temp.low;
                shared_max_val_high[l_id] = temp.high;
            }
            if (t_st > shared_steps[l_id]) {
                shared_steps[l_id] = t_st;
            }
            if (t_si > shared_sigma[l_id]) {
                shared_sigma[l_id] = t_si;
            }
        }
        barrier();
    }

    // Stride 4
    {
        uint64_t t_low = 0UL; uint64_t t_high = 0UL; uint t_st = 0; uint t_si = 0;
        if (l_id >= 4) {
            t_low = shared_max_val_low[l_id - 4];
            t_high = shared_max_val_high[l_id - 4];
            t_st = shared_steps[l_id - 4];
            t_si = shared_sigma[l_id - 4];
        }
        barrier();
        if (l_id >= 4) {
            uint128 temp; temp.low = t_low; temp.high = t_high;
            uint128 my_val; my_val.low = shared_max_val_low[l_id]; my_val.high = shared_max_val_high[l_id];
            if (greater_than(temp, my_val)) {
                shared_max_val_low[l_id] = temp.low;
                shared_max_val_high[l_id] = temp.high;
            }
            if (t_st > shared_steps[l_id]) {
                shared_steps[l_id] = t_st;
            }
            if (t_si > shared_sigma[l_id]) {
                shared_sigma[l_id] = t_si;
            }
        }
        barrier();
    }

    // Stride 8
    {
        uint64_t t_low = 0UL; uint64_t t_high = 0UL; uint t_st = 0; uint t_si = 0;
        if (l_id >= 8) {
            t_low = shared_max_val_low[l_id - 8];
            t_high = shared_max_val_high[l_id - 8];
            t_st = shared_steps[l_id - 8];
            t_si = shared_sigma[l_id - 8];
        }
        barrier();
        if (l_id >= 8) {
            uint128 temp; temp.low = t_low; temp.high = t_high;
            uint128 my_val; my_val.low = shared_max_val_low[l_id]; my_val.high = shared_max_val_high[l_id];
            if (greater_than(temp, my_val)) {
                shared_max_val_low[l_id] = temp.low;
                shared_max_val_high[l_id] = temp.high;
            }
            if (t_st > shared_steps[l_id]) {
                shared_steps[l_id] = t_st;
            }
            if (t_si > shared_sigma[l_id]) {
                shared_sigma[l_id] = t_si;
            }
        }
        barrier();
    }

    // Stride 16
    {
        uint64_t t_low = 0UL; uint64_t t_high = 0UL; uint t_st = 0; uint t_si = 0;
        if (l_id >= 16) {
            t_low = shared_max_val_low[l_id - 16];
            t_high = shared_max_val_high[l_id - 16];
            t_st = shared_steps[l_id - 16];
            t_si = shared_sigma[l_id - 16];
        }
        barrier();
        if (l_id >= 16) {
            uint128 temp; temp.low = t_low; temp.high = t_high;
            uint128 my_val; my_val.low = shared_max_val_low[l_id]; my_val.high = shared_max_val_high[l_id];
            if (greater_than(temp, my_val)) {
                shared_max_val_low[l_id] = temp.low;
                shared_max_val_high[l_id] = temp.high;
            }
            if (t_st > shared_steps[l_id]) {
                shared_steps[l_id] = t_st;
            }
            if (t_si > shared_sigma[l_id]) {
                shared_sigma[l_id] = t_si;
            }
        }
        barrier();
    }

    // Stride 32
    {
        uint64_t t_low = 0UL; uint64_t t_high = 0UL; uint t_st = 0; uint t_si = 0;
        if (l_id >= 32) {
            t_low = shared_max_val_low[l_id - 32];
            t_high = shared_max_val_high[l_id - 32];
            t_st = shared_steps[l_id - 32];
            t_si = shared_sigma[l_id - 32];
        }
        barrier();
        if (l_id >= 32) {
            uint128 temp; temp.low = t_low; temp.high = t_high;
            uint128 my_val; my_val.low = shared_max_val_low[l_id]; my_val.high = shared_max_val_high[l_id];
            if (greater_than(temp, my_val)) {
                shared_max_val_low[l_id] = temp.low;
                shared_max_val_high[l_id] = temp.high;
            }
            if (t_st > shared_steps[l_id]) {
                shared_steps[l_id] = t_st;
            }
            if (t_si > shared_sigma[l_id]) {
                shared_sigma[l_id] = t_si;
            }
        }
        barrier();
    }

    // Stride 64
    {
        uint64_t t_low = 0UL; uint64_t t_high = 0UL; uint t_st = 0; uint t_si = 0;
        if (l_id >= 64) {
            t_low = shared_max_val_low[l_id - 64];
            t_high = shared_max_val_high[l_id - 64];
            t_st = shared_steps[l_id - 64];
            t_si = shared_sigma[l_id - 64];
        }
        barrier();
        if (l_id >= 64) {
            uint128 temp; temp.low = t_low; temp.high = t_high;
            uint128 my_val; my_val.low = shared_max_val_low[l_id]; my_val.high = shared_max_val_high[l_id];
            if (greater_than(temp, my_val)) {
                shared_max_val_low[l_id] = temp.low;
                shared_max_val_high[l_id] = temp.high;
            }
            if (t_st > shared_steps[l_id]) {
                shared_steps[l_id] = t_st;
            }
            if (t_si > shared_sigma[l_id]) {
                shared_sigma[l_id] = t_si;
            }
        }
        barrier();
    }

    // Stride 128
    {
        uint64_t t_low = 0UL; uint64_t t_high = 0UL; uint t_st = 0; uint t_si = 0;
        if (l_id >= 128) {
            t_low = shared_max_val_low[l_id - 128];
            t_high = shared_max_val_high[l_id - 128];
            t_st = shared_steps[l_id - 128];
            t_si = shared_sigma[l_id - 128];
        }
        barrier();
        if (l_id >= 128) {
            uint128 temp; temp.low = t_low; temp.high = t_high;
            uint128 my_val; my_val.low = shared_max_val_low[l_id]; my_val.high = shared_max_val_high[l_id];
            if (greater_than(temp, my_val)) {
                shared_max_val_low[l_id] = temp.low;
                shared_max_val_high[l_id] = temp.high;
            }
            if (t_st > shared_steps[l_id]) {
                shared_steps[l_id] = t_st;
            }
            if (t_si > shared_sigma[l_id]) {
                shared_sigma[l_id] = t_si;
            }
        }
        barrier();
    }

    if (active_thread) {
        // Max value local peak check
        uint128 prev_max_val;
        prev_max_val.low = (l_id == 0) ? 0UL : shared_max_val_low[l_id - 1];
        prev_max_val.high = (l_id == 0) ? 0UL : shared_max_val_high[l_id - 1];

        if (greater_than(max_val, prev_max_val)) {
            if (greater_than(max_val, init_max_val)) {
                uint idx = atomicAdd(peaks_count.max_val_count, 1);
                if (idx < 65536) {
                    max_value_peaks[idx].start_low = n.low;
                    max_value_peaks[idx].start_high = n.high;
                    max_value_peaks[idx].val_low = max_val.low;
                    max_value_peaks[idx].val_high = max_val.high;
                }

                uint128 current_g;
                current_g.low = global_peaks.max_val_low;
                current_g.high = global_peaks.max_val_high;
                if (greater_than(max_val, current_g)) {
                    global_peaks.max_val_low = max_val.low;
                    global_peaks.max_val_high = max_val.high;
                }
            }
        }

        // Steps local peak check
        uint prev_steps = (l_id == 0) ? 0 : shared_steps[l_id - 1];
        if (steps > prev_steps) {
            if (steps > init_max_steps) {
                uint idx = atomicAdd(peaks_count.steps_count, 1);
                if (idx < 65536) {
                    steps_peaks[idx].start_low = n.low;
                    steps_peaks[idx].start_high = n.high;
                    steps_peaks[idx].val_low = uint64_t(steps);
                    steps_peaks[idx].val_high = 0UL;
                }

                atomicMax(global_peaks.max_steps, steps);
            }
        }

        // Sigma local peak check
        uint prev_sigma = (l_id == 0) ? 0 : shared_sigma[l_id - 1];
        if (stopping_time > prev_sigma) {
            if (stopping_time > init_max_sigma) {
                uint idx = atomicAdd(peaks_count.sigma_count, 1);
                if (idx < 65536) {
                    sigma_peaks[idx].start_low = n.low;
                    sigma_peaks[idx].start_high = n.high;
                    sigma_peaks[idx].val_low = uint64_t(stopping_time);
                    sigma_peaks[idx].val_high = 0UL;
                }

                atomicMax(global_peaks.max_sigma, stopping_time);
            }
        }
    }
}
