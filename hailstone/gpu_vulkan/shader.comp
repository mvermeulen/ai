layout(constant_id = 0) const bool USE_64BIT = false;
layout(constant_id = 1) const bool USE_SUFFIX_FIRST = false;
layout(constant_id = 2) const bool USE_DOMAIN_SWITCHING = false;

layout(local_size_x = 256) in;

struct uint128 {
    uint64_t low;
    uint64_t high;
};

// Push Constants
layout(push_constant) uniform PushConstants {
    uint64_t start_prefix_low;
    uint64_t start_prefix_high;
    uint64_t start_val_low;
    uint64_t start_val_high;
    uint64_t end_val_low;
    uint64_t end_val_high;
    uint allowed_suffixes_size;
    uint cutoff_width;
    uint total_work_items;
    uint allowed_offset;
    uint prefix_stride;
    uint check_start;
    uint check_end;
    uint64_t init_max_val_low;
    uint64_t init_max_val_high;
    uint init_max_steps;
    uint init_max_sigma;
} pcs;

// Binding 0: Current global maximum metrics (used for peak checks)
layout(std430, binding = 0) coherent buffer GlobalPeaks {
    uint64_t max_val_low;
    uint64_t max_val_high;
    uint max_steps;
    uint max_sigma;
} global_peaks;

// Binding 1: Mutex Lock for 128-bit peak updates
layout(std430, binding = 1) coherent buffer LockBuffer {
    uint lock;
} lock_buf;

// Binding 2: Peak logs sizes
layout(std430, binding = 2) coherent buffer PeaksCount {
    uint max_val_count;
    uint steps_count;
    uint sigma_count;
} peaks_count;

// Structs for peak records
struct PeakRecord {
    uint64_t start_low;
    uint64_t start_high;
    uint64_t val_low;
    uint64_t val_high;
};

// Binding 3: Max Value Peaks Log
layout(std430, binding = 3) coherent buffer MaxValuePeaks {
    PeakRecord max_value_peaks[];
};

// Binding 4: Steps Peaks Log
layout(std430, binding = 4) coherent buffer StepsPeaks {
    PeakRecord steps_peaks[];
};

// Binding 5: Sigma Peaks Log
layout(std430, binding = 5) coherent buffer SigmaPeaks {
    PeakRecord sigma_peaks[];
};

// Binding 6: Metrics
layout(std430, binding = 6) coherent buffer GlobalMetrics {
    uint64_t total_checked;
    uint64_t total_steps;
    uint64_t skipped_mod6;
    uint64_t overflowed;
} global_metrics;

// Binding 7: Steps Table
layout(std430, binding = 7) readonly buffer StepsTable {
    uint steps[256];
} steps_table;

// Binding 8: Allowed Suffixes Buffer
layout(std430, binding = 8) readonly buffer AllowedSuffixes {
    uint allowed[];
} allowed_suffixes;

struct poly {
    uint mul3;
    uint div2;
    uint steps;
    uint add;
    uint smaller;
};

// Binding 9: Vermeulen Polynomial Table Buffer
layout(std430, binding = 9) readonly buffer FPolyTable {
    poly polys[256];
} fpoly_table;

