# Example Configuration File
# Rename this file to .env and place it in the project root directory alongside start.sh

# The Gmail account you created or are using for BillMinder
SMTP_USER=your.secondary.gmail@gmail.com

# The 16-character App Password generated in Google Account settings (no spaces)
SMTP_PASS=abcdefghijklmnop

# The email address where you want to receive the weekly BillMinder reports
SMTP_TO=your.primary.email@example.com
