{
  "name": "wpsync-v2",
  "version": "0.1.0",
  "description": "Offline-first authoring and sync tool for the Gone2Look4America WordPress site -- local SQLite mirror + event-sourced outbox + browser dashboard",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "wpsync2": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dashboard": "tsx src/server.ts",
    "cli": "tsx src/cli.ts",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.9.0",
    "express": "^4.21.2",
    "multer": "^2.2.0",
    "node-diff3": "^3.1.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
