{
  "name": "wordpress-local-sync",
  "version": "0.1.0",
  "description": "Local-first offline editing and safe sync for WordPress sites",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "wp-local-sync": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
