# WordPress base URL, no trailing slash
WP_SITE_URL=https://example.com

# Credentials (application password)
WP_USERNAME=your-user
WP_APPLICATION_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Comma-separated hostnames allowed for apply
WP_ALLOWED_HOSTS=example.com

# Safety defaults
WP_PLAN_MAX_OPERATIONS=20
WP_PLAN_MAX_AGE_HOURS=72
