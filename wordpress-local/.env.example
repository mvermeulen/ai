# WordPress site base URL (no trailing slash)
WP_SITE_URL=https://example.com

# WordPress application password auth user and app password
WP_USERNAME=your-user
WP_APPLICATION_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Comma-separated hostnames that are allowed as sync targets
WP_ALLOWED_HOSTS=example.com

# Abort sync apply when operation count exceeds this number unless overridden
WP_MAX_APPLY_OPERATIONS=25
